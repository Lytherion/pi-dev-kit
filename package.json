{
  "name": "pi-dev-kit",
  "version": "1.0.0",
  "description": "Pi development kit for planning, project maps, and sandboxed permissions.",
  "type": "module",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lytherion/pi-dev-kit.git"
  },
  "homepage": "https://github.com/Lytherion/pi-dev-kit#readme",
  "bugs": {
    "url": "https://github.com/Lytherion/pi-dev-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "security",
    "permissions",
    "sandbox",
    "workflow",
    "planning"
  ],
  "author": "lvyiqiang",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/permissions.ts",
      "./extensions/workflow.ts",
      "./extensions/questionnaire.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "tsx": "^4.23.15",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  }
}
